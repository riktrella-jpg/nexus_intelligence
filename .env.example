# ========================================================
# Variables de Entorno de Producción - NEXUS INTELLIGENCE
# ========================================================

# Dominio público configurado (ej: nexus.tuempresa.com)
DOMAIN=nexus.tuempresa.com

# URL pública del Backend a la que accederá el Frontend desde los navegadores de los usuarios
NEXT_PUBLIC_API_URL=https://api.tuempresa.com

# Orígenes autorizados en Backend para CORS (separados por coma o '*' para abierto)
NEXUS_CORS_ORIGINS=https://nexus.tuempresa.com,https://tu-proyecto.vercel.app

# Expresión regular para orígenes de preview (ej: Vercel)
NEXUS_CORS_REGEX=^https:\/\/.*\.vercel\.app$

# Límite máximo de carga de archivos (en Megabytes)
NEXUS_MAX_UPLOAD_MB=500

# Clave de API de IA (opcional, para modelos externos)
NEXUS_AI_API_KEY=
